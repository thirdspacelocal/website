{{- /*
Content adapter: turns Kit's events feed into one Hugo page per event.

Three things here are deliberate and easy to get wrong later:

 1. SAMPLE DATA CAN NEVER REACH THE LIVE SITE. A production build with no feed
    URL configured is a build error, not a quiet fallback -- publishing
    invented events on a real brewery's website is worse than publishing
    nothing. The sample file exists so `hugo server` works offline.

 2. THE FALLBACK IS LAST-GOOD, NOT SAMPLE. If the feed is unreachable mid
    build, we publish data/events.json (the last real feed we committed) and
    warn. Kit being down should not blank the events page.

 3. RECURRENCE IS EXPANDED IN THE EVENT'S OWN NAMED ZONE. A weekly 7pm event
    stays at 7pm across a DST change only if the next date is resolved in
    America/Denver rather than by reusing the offset that happened to apply
    when the series started. Same rule Kit follows on the calendar side.
*/ -}}

{{- $url := getenv "KIT_EVENTS_URL" -}}
{{- $token := getenv "KIT_EVENTS_TOKEN" -}}
{{- $opts := dict "headers" (dict "Authorization" (printf "Bearer %s" $token)) -}}
{{- $feed := "" -}}

{{- /* One source: Kit, fetched fresh on every build. There is deliberately no
       committed copy to fall back on.

       There used to be. It looked like insurance against a Kit outage, and in
       practice it did the opposite: a build with no credentials configured
       fell back to the stored file, succeeded, and republished frozen data.
       The site looked healthy through repeated deploys while events edited in
       Kit never appeared -- the worst kind of failure, because everything
       reported success.

       Failing the build is better. Netlify keeps serving the last good deploy,
       so nothing goes down, and the build log says exactly what is wrong. */ -}}
{{- if not (and $url $token) -}}
  {{- errorf "events: KIT_EVENTS_URL and KIT_EVENTS_TOKEN are not set. The events section is built from Kit's feed on every deploy; there is no stored copy to fall back on, by design." -}}
{{- else -}}
  {{- with try (resources.GetRemote $url $opts) -}}
    {{- with .Err -}}
      {{- errorf "events: could not fetch the feed from Kit (%s). Refusing to build rather than republish whatever the site was last built with." . -}}
    {{- else with .Value -}}
      {{- /* A wrong path returns Kit's HTML error page with a 200, and
             unmarshalling that yields an XML parse error naming a line number
             in a file nobody has -- useless at 2am. Check the type first. */ -}}
      {{- if not (in .MediaType.Type "json") -}}
        {{- errorf "events: %s returned %s, not JSON. Check KIT_EVENTS_URL points at the feed (…/events/feed.json)." $url .MediaType.Type -}}
      {{- else -}}
        {{- $feed = .Content | transform.Unmarshal -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $items := slice -}}
{{- with $feed -}}{{- $items = .events | default slice -}}{{- end -}}
{{- warnf "events: building %d event page(s) from Kit" (len $items) -}}

{{- range $items -}}
  {{- $slug := .slug -}}
  {{- $tz := .timezone | default "America/Denver" -}}
  {{- $start := time.AsTime .starts_at -}}
  {{- $next := $start -}}
  {{- $recurring := hasPrefix (.recurrence | default "") "FREQ=WEEKLY" -}}

  {{- /* Declared out here rather than inside the branch below, because the
         JSON-LD needs the weekday list too: schema.org describes a weekly
         series by its byDay, and a variable scoped to the `if` would be out of
         scope by the time AddPage runs. */ -}}
  {{- $targets := slice -}}

  {{- if $recurring -}}
    {{- /* Which weekday(s) does the series land on? BYDAY is optional; without
           it RFC 5545 takes the weekday from DTSTART. */ -}}
    {{- $names := dict "MO" "Monday" "TU" "Tuesday" "WE" "Wednesday" "TH" "Thursday" "FR" "Friday" "SA" "Saturday" "SU" "Sunday" -}}
    {{- range (split .recurrence ";") -}}
      {{- if hasPrefix . "BYDAY=" -}}
        {{- range (split (strings.TrimPrefix "BYDAY=" .) ",") -}}
          {{- with index $names (trim . " ") -}}{{- $targets = $targets | append . -}}{{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- if not $targets -}}{{- $targets = slice ($start.Format "Monday") -}}{{- end -}}

    {{- /* First day from today whose weekday matches. Compared by NAME so no
           weekday arithmetic is needed -- there is no int cast for
           time.Weekday in templates, and a wrong one would silently shift the
           whole series by a day. */ -}}
    {{- $today := now -}}
    {{- if lt ($start.Unix) ($today.Unix) -}}
      {{- $wall := $start.Format "15:04:05" -}}
      {{- range $i := seq 0 7 -}}
        {{- $cand := $today.AddDate 0 0 $i -}}
        {{- if and (in $targets ($cand.Format "Monday")) (eq $next $start) -}}
          {{- $next = time.AsTime (printf "%sT%s" ($cand.Format "2006-01-02") $wall) $tz -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* End time. For a repeat, carry the DURATION forward rather than the
         stored end date -- the stored end belongs to the first occurrence,
         which for a series that began in 2024 would print a date two years
         ago next to this week's start. A two-hour quiz stays two hours. */ -}}
  {{- $nextEnd := "" -}}
  {{- with .ends_at -}}
    {{- $end := time.AsTime . -}}
    {{- $nextEnd = $next.Add ($end.Sub $start) -}}
  {{- end -}}

  {{- /* One label, built once, used by the list, the hero and the detail page
         -- so they can never disagree about when something happens. */ -}}
  {{- $when := "" -}}
  {{- $day := $next.Format "Monday, January 2" -}}
  {{- $from := $next.Format "3:04pm" -}}
  {{- if $recurring -}}
    {{- $when = printf "Every %s · %s" ($next.Format "Monday") $from -}}
    {{- with $nextEnd }}{{ $when = printf "%s–%s" $when (.Format "3:04pm") }}{{ end -}}
  {{- else if .all_day -}}
    {{- $when = $day -}}
    {{- /* An all-day span ends at midnight ON the following day, so the last
           day people can actually turn up is the day before. */ -}}
    {{- with $nextEnd -}}
      {{- $last := .AddDate 0 0 -1 -}}
      {{- if gt ($last.Format "2006-01-02") ($next.Format "2006-01-02") -}}
        {{- $when = printf "%s – %s" $day ($last.Format "Monday, January 2") -}}
      {{- end -}}
    {{- end -}}
  {{- else -}}
    {{- $when = printf "%s · %s" $day $from -}}
    {{- with $nextEnd -}}
      {{- if eq (.Format "2006-01-02") ($next.Format "2006-01-02") -}}
        {{- $when = printf "%s–%s" $when (.Format "3:04pm") -}}
      {{- else -}}
        {{- /* Spans midnight or several days: the end needs its own date or
               "9:00pm–2:00am" reads as ending earlier than it started. */ -}}
        {{- $when = printf "%s – %s · %s" $when (.Format "Monday, January 2") (.Format "3:04pm") -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- /* A free event and an event with no price set are different things, and
         `with` cannot tell them apart -- it treats 0 as empty, so every free
         event silently loses its "Free" label. Kit omits the key entirely when
         no price applies, so presence is the real signal. */ -}}
  {{- $price := "" -}}
  {{- if isset . "price_cents" -}}
    {{- $cents := float .price_cents -}}
    {{- if gt $cents 0.0 -}}
      {{- $price = printf "$%.2f" (div $cents 100.0) -}}
    {{- else -}}
      {{- $price = "Free" -}}
    {{- end -}}
  {{- end -}}

  {{- /* date drives sorting and display. publishDate MUST be a past instant:
         Hugo derives publishDate from date when it is omitted and then
         excludes every future-dated page -- which on an events site is all of
         them, so the section renders empty. updated_at is when Kit actually
         published the item, so it is truthful and always in the past. */ -}}
  {{- /* Download the poster and attach it to the page as a resource, so Hugo
         fingerprints it and Netlify serves it from the brewery's own domain.
         The public site must carry no link back to Kit: it should keep working
         if Kit is down, and the pages should not depend on our uptime.
         A failed fetch is a warning, not a build break -- the layout falls
         back to house artwork. */ -}}
  {{- $posterOK := false -}}
  {{- /* Only attempt the download when there is a token to do it with.
         Offline dev has none, and the fetch would fail once per event for a
         reason that is expected rather than interesting. */ -}}
  {{- with (and $token .image_url) -}}
    {{- with try (resources.GetRemote . $opts) -}}
      {{- with .Err -}}
        {{- warnf "events: poster fetch failed (%s)" . -}}
      {{- else with .Value -}}
        {{- /* Keep the real extension: the published file is served by
               Netlify, which types it from the filename. An extensionless
               "poster" gets guessed at, and browsers may refuse to render it. */ -}}
        {{- $ext := .MediaType.FirstSuffix.Suffix | default "jpg" -}}
        {{- $.AddResource (dict
          "path"    (printf "%s/poster.%s" $slug $ext)
          "content" (dict "mediaType" .MediaType.Type "value" .Content)
        ) -}}
        {{- $posterOK = true -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $.AddPage (dict
    "path"    .slug
    "kind"    "page"
    "title"   .title
    "content" (dict "mediaType" "text/markdown" "value" (.description | default ""))
    "dates"   (dict "date" $next "publishDate" (.updated_at | default "2000-01-01T00:00:00Z" | time.AsTime) "lastmod" (.updated_at | default "2000-01-01T00:00:00Z" | time.AsTime))
    "params"  (dict
      "featured"        (.featured | default false)
      "hasPoster"       $posterOK
      "kitID"           .id
      "eventType"       (.type | default "event")
      "summary"         (.summary | default "")
      "startsAt"        $start
      "nextStart"       $next
      "endsAt"          (.ends_at | default "")
      "nextEnd"         $nextEnd
      "allDay"          (.all_day | default false)
      "timezone"        $tz
      "recurring"       $recurring
      "recurrence"      (.recurrence | default "")
      "byDay"           $targets
      "whenLabel"       $when
      "location"        (.location | default "")
      "priceLabel"      $price
      "priceCents"      (.price_cents | default 0)
      "currency"        (.currency | default "USD")
      "capacity"        (.capacity | default 0)
      "registrationURL" (.registration_url | default "")
      "canonicalURL"    (.canonical_url | default "")
    )
  ) -}}
{{- end -}}
